// Pure-Oreslang CPU tensor MLP integration gate, NOT a verified native run.
// Architecture 1 -> Dense(2) -> ReLU -> Dense(1), trained on 4 examples.
// Unlike the scalar tape demo, both dense layers and all weight VJPs use
// rank-2 TensorF64 kernels. No host ML library or handwritten dense VJP.
// Requires same-workspace sibling repos oreslang-tensor and oreslang-autograd,
// including autograd PR #10; each pinned compiler run must record both SHAs.
// Fixed dimensions keep P0 output buffers explicit until owned Array<T> lands.
import module Assert from 'std/assert';
import class TensorF64 from '../../oreslang-tensor/src/tensor';
import fnc matmul_2d_f64_into, add_f64_into, relu_f64_into
  from '../../oreslang-tensor/src/tensor';
import fnc matmul_2d_vjp_f64_checked_into
  from '../../oreslang-tensor/src/matmul_vjp';
import fnc relu_vjp_f64_checked_into, mse_vjp_f64_checked_into
  from '../../oreslang-autograd/src/tensor_training_vjp';

fnc finite_f64(float x): bool {
  return (x - x) == 0.0;
}

pub routine main(): void {
  val List<float> inputs = arr[0.0,1.0,2.0,3.0];
  val List<float> targets = arr[1.0,3.0,5.0,7.0];
  // W1=[1,2], b1=[1,2], W2=[2,1], b2=[1,1].
  val List<float> w1 = arr[0.8,0.25];
  val List<float> b1 = arr[0.2,0.1];
  val List<float> w2 = arr[0.5,0.3];
  val List<float> b2 = arr[0.1];
  val float rate = 0.02;
  let float first_loss = 0.0;
  let float last_loss = 0.0;

  for int epoch = 0; epoch < 600; epoch++ do
    val List<float> gw1 = arr[0.0,0.0];
    val List<float> gb1 = arr[0.0,0.0];
    val List<float> gw2 = arr[0.0,0.0];
    let float gb2 = 0.0;
    let float loss = 0.0;
    for int sample = 0; sample < 4; sample++ do
      val TensorF64 x = new TensorF64(arr[1,1],arr[inputs[sample]]);
      val TensorF64 first_weights = new TensorF64(arr[1,2],w1);
      val TensorF64 first_bias = new TensorF64(arr[1,2],b1);
      val TensorF64 second_weights = new TensorF64(arr[2,1],w2);
      val TensorF64 second_bias = new TensorF64(arr[1,1],b2);
      val TensorF64 target = new TensorF64(arr[1,1],arr[targets[sample]]);

      // Forward pass: X@W1 + b1 -> ReLU -> H@W2 + b2.
      val List<float> first_matmul = arr[0.0,0.0];
      val List<float> first_preactivation = arr[0.0,0.0];
      val List<float> hidden = arr[0.0,0.0];
      val List<float> second_matmul = arr[0.0];
      val List<float> prediction = arr[0.0];
      Assert.true_throws(matmul_2d_f64_into(x,first_weights,first_matmul).is_ok());
      Assert.true_throws(add_f64_into(
        new TensorF64(arr[1,2],first_matmul),first_bias,first_preactivation
      ).is_ok());
      Assert.true_throws(relu_f64_into(
        new TensorF64(arr[1,2],first_preactivation),hidden
      ).is_ok());
      Assert.true_throws(matmul_2d_f64_into(
        new TensorF64(arr[1,2],hidden),second_weights,second_matmul
      ).is_ok());
      Assert.true_throws(add_f64_into(
        new TensorF64(arr[1,1],second_matmul),second_bias,prediction
      ).is_ok());
      val float residual = prediction[0] - targets[sample];
      loss = loss + residual * residual;

      // Reverse pass uses reusable tensor VJP operators, not hand-written
      // derivatives for either dense layer. The saved ReLU values are checked.
      val List<float> dy = arr[0.0];
      Assert.true_throws(mse_vjp_f64_checked_into(
        new TensorF64(arr[1,1],prediction),target,dy
      ).is_ok());
      val TensorF64 loss_upstream = new TensorF64(arr[1,1],dy);
      val List<float> dh_scratch = arr[0.0,0.0];
      val List<float> dw2_scratch = arr[0.0,0.0];
      val List<float> dh = arr[0.0,0.0];
      val List<float> dw2 = arr[0.0,0.0];
      Assert.true_throws(matmul_2d_vjp_f64_checked_into(
        new TensorF64(arr[1,2],hidden),second_weights,loss_upstream,
        dh_scratch,dw2_scratch,dh,dw2
      ).is_ok());
      val List<float> dz = arr[0.0,0.0];
      Assert.true_throws(relu_vjp_f64_checked_into(
        new TensorF64(arr[1,2],first_preactivation),
        new TensorF64(arr[1,2],hidden),
        new TensorF64(arr[1,2],dh),dz
      ).is_ok());
      val List<float> dx_scratch = arr[0.0];
      val List<float> dw1_scratch = arr[0.0,0.0];
      val List<float> dx = arr[0.0];
      val List<float> dw1 = arr[0.0,0.0];
      Assert.true_throws(matmul_2d_vjp_f64_checked_into(
        x,first_weights,new TensorF64(arr[1,2],dz),
        dx_scratch,dw1_scratch,dx,dw1
      ).is_ok());
      for int j = 0; j < 2; j++ do
        gw1[j] = gw1[j] + dw1[j];
        gb1[j] = gb1[j] + dz[j];
        gw2[j] = gw2[j] + dw2[j];
      done
      gb2 = gb2 + dy[0];
    done

    last_loss = loss / 4.0;
    if epoch == 0; do
      first_loss = last_loss;
    fi
    // Candidate preflight across ALL seven scalar parameters BEFORE mutation.
    // In an actor this publication must happen under one version-fenced
    // exclusive state loan. This standalone numeric gate has no actor state.
    val float step_rate = rate / 4.0;
    if !finite_f64(last_loss) || !finite_f64(gb2); do
      Assert.true_throws(false);
    fi
    for int j = 0; j < 2; j++ do
      Assert.true_throws(finite_f64(gw1[j]) && finite_f64(gb1[j]) &&
        finite_f64(gw2[j]) &&
        finite_f64(w1[j] - step_rate*gw1[j]) &&
        finite_f64(b1[j] - step_rate*gb1[j]) &&
        finite_f64(w2[j] - step_rate*gw2[j]));
    done
    Assert.true_throws(finite_f64(b2[0] - step_rate*gb2));
    for int j = 0; j < 2; j++ do
      w1[j] = w1[j] - step_rate*gw1[j];
      b1[j] = b1[j] - step_rate*gb1[j];
      w2[j] = w2[j] - step_rate*gw2[j];
    done
    b2[0] = b2[0] - step_rate*gb2;
  done

  Assert.true_throws(first_loss > 10.0);
  Assert.true_throws(last_loss < first_loss);
  Assert.true_throws(last_loss < 0.000001);
  stdio.println("ORES_ML_TENSOR_TWO_LAYER_VJP_PASS");
}

// Aligned data loading -> supervised minibatch -> pure Oreslang SGD.
// Requires sibling oreslang-tensor implementing row_batches.ores.
// No actor/accelerator runtime or compiler execution implied by this source.
import module Assert from "std/assert";
import class TensorF64 from "../../oreslang-tensor/src/tensor";
import fnc gather_supervised_batch_f64_checked_into from "../src/dataset_batches";
import fnc train_affine_step, affine_batch_into, mse_loss from "../src/linear";

pub routine main(): void {
  val TensorF64 features = new TensorF64(arr[4, 1], arr[0.0, 1.0, 2.0, 3.0]);
  val TensorF64 labels = new TensorF64(arr[4, 1], arr[1.0, 3.0, 5.0, 7.0]);
  val List<float> fx_scratch = arr[0.0, 0.0, 0.0];
  val List<float> fy_scratch = arr[0.0, 0.0, 0.0];
  val List<float> bx = arr[0.0, 0.0, 0.0];
  val List<float> by = arr[0.0, 0.0, 0.0];

  // Duplicate row 3 must be retained; gradient contribution is doubled.
  Assert.true_throws(gather_supervised_batch_f64_checked_into(
    features, labels, arr[3, 1, 3], fx_scratch, fy_scratch, bx, by
  ).is_ok());
  Assert.equal_throws(bx[0], 3.0);
  Assert.equal_throws(bx[1], 1.0);
  Assert.equal_throws(bx[2], 3.0);
  Assert.equal_throws(by[0], 7.0);
  Assert.equal_throws(by[1], 3.0);
  Assert.equal_throws(by[2], 7.0);

  // Reject malformed row indices without overwriting BOTH caller outputs.
  val List<float> bad_x = arr[99.0, 99.0, 99.0];
  val List<float> bad_y = arr[88.0, 88.0, 88.0];
  Assert.true_throws(gather_supervised_batch_f64_checked_into(
    features, labels, arr[3, 4, 3],
    fx_scratch, fy_scratch, bad_x, bad_y
  ).is_err());
  Assert.equal_throws(bad_x[0], 99.0);
  Assert.equal_throws(bad_y[2], 88.0);
  Assert.true_throws(gather_supervised_batch_f64_checked_into(
    features, labels, arr[3, 1, 3],
    fx_scratch, fy_scratch, bad_x, bad_x
  ).is_err());
  Assert.equal_throws(bad_x[0], 99.0);

  // Actual pure-Oreslang affine training on an extracted minibatch:
  // mean squared error backprop implemented in src/linear.ores.
  val List<float> weights = arr[0.0];
  val List<float> biases = arr[0.0];
  for int epoch = 0; epoch < 500; epoch++ do
    Assert.true_throws(train_affine_step(bx, by, weights, biases, 0.05).is_ok());
  done
  val List<float> predictions = arr[0.0, 0.0, 0.0];
  Assert.true_throws(affine_batch_into(bx, weights[0], biases[0], predictions).is_ok());
  Assert.true_throws(mse_loss(predictions, by).unwrap() < 0.000001);
  Assert.true_throws(weights[0] > 1.99 && weights[0] < 2.01);
  Assert.true_throws(biases[0] > 0.99 && biases[0] < 1.01);
  stdio.println("ORES_ML_ALIGNED_DATASET_TRAINING_PASS");
  return;
}

// Candidate REAL Oreslang CPU guest smoke program (not yet executed).
// The low and nonlinear KAN edges are single local cubic segments; all spline
// inputs are explicitly in [0,1]. No hidden framework or JS math at runtime.
import module Assert from "std/assert";
import fnc kan_cubic_segment_f64, kan_cubic_segment_dinput_f64,
           kan_cubic_segment_dcoeff_f64, mfkan_residual_blend_f64
    from "../src/kan/cubic_bspline_f64";

pub routine main(): void {
    val Result<float, String> low_result =
        kan_cubic_segment_f64(0.5, 0.5, 0.5, 0.5, 0.5);
    Assert.true_throws(low_result.is_ok());
    val float low = low_result.unwrap();
    Assert.true_throws(low > 0.499999 && low < 0.500001);

    // Here the non-linear high correction consumes both original feature t
    // and the low-fidelity prediction, illustrating the MFKAN DAG join.
    val Result<float, String> edge_x =
        kan_cubic_segment_f64(0.5, 0.2, 0.2, 0.2, 0.2);
    val Result<float, String> edge_low =
        kan_cubic_segment_f64(low, 0.1, 0.1, 0.1, 0.1);
    Assert.true_throws(edge_x.is_ok() && edge_low.is_ok());
    val float nonlinear_correction = edge_x.unwrap() + edge_low.unwrap();
    val float linear_correction = (0.2 * 0.5) + (0.4 * low) + 0.1;

    val Result<float, String> high_result = mfkan_residual_blend_f64(
        low, linear_correction, nonlinear_correction, 0.25
    );
    Assert.true_throws(high_result.is_ok());
    Assert.true_throws(high_result.unwrap() > 0.824999
        && high_result.unwrap() < 0.825001);

    val Result<float, String> d_input =
        kan_cubic_segment_dinput_f64(0.5, 0.5, 0.5, 0.5, 0.5);
    val Result<float, String> d_coeff = kan_cubic_segment_dcoeff_f64(0.5, 1);
    Assert.true_throws(d_input.is_ok() && d_coeff.is_ok());
    Assert.true_throws(d_input.unwrap() > -0.000001
        && d_input.unwrap() < 0.000001);
    Assert.true_throws(d_coeff.unwrap() > 0.479165
        && d_coeff.unwrap() < 0.479168);
    stdio.println("ORES_KAN_MFKAN_SCALAR_PASS");
    return;
}

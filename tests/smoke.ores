import module Assert from "std/assert";
import module Linear from "../src/linear.ores";

pub routine main(): void {
  val List<float> input = arr[0.0, 1.0, 2.0, 3.0];
  val List<float> target = arr[1.0, 3.0, 5.0, 7.0];
  val List<float> weights = arr[0.0];
  val List<float> biases = arr[0.0];

  val List<float> short_target = arr[1.0];
  val List<float> empty_gradients = arr[];
  val List<float> unit_gradient = arr[2.0];
  val List<float> vector_gradient = arr[2.0, 4.0];
  val List<float> ones_gradient = arr[1.0, 1.0];

  // Reject overlapping loans before publishing CPU kernel outputs.
  val List<float> shared_forward = arr[1.0, 2.0];
  Assert.true_throws(Linear.affine_batch_into(
    rt borrow shared_forward, 2.0, 1.0, rt mut borrow shared_forward
  ).is_err());
  Assert.equal_throws(shared_forward[0], 1.0);
  Assert.equal_throws(shared_forward[1], 2.0);

  // Validate before mutation, including malformed target length.
  Assert.true_throws(
    Linear.train_affine_step(rt borrow input, rt borrow short_target, rt mut borrow weights, rt mut borrow biases, 0.05).is_err()
  );
  Assert.equal_throws(weights[0], 0.0);
  Assert.equal_throws(biases[0], 0.0);
  Assert.true_throws(Linear.train_affine_step(
    rt borrow input, rt borrow target, rt mut borrow weights, rt mut borrow weights, 0.05
  ).is_err());
  Assert.equal_throws(weights[0], 0.0);
  // A rejected learning rate must not publish either trained scalar.
  Assert.true_throws(Linear.train_affine_step(rt borrow input, rt borrow target, rt mut borrow weights, rt mut borrow biases, 0.0).is_err());
  Assert.true_throws(Linear.train_affine_step(rt borrow input, rt borrow target, rt mut borrow weights, rt mut borrow biases, -0.05).is_err());
  Assert.equal_throws(weights[0], 0.0);
  Assert.equal_throws(biases[0], 0.0);

  for int step = 0; step < 500; step++ do
    Assert.true_throws(
      Linear.train_affine_step(rt borrow input, rt borrow target, rt mut borrow weights, rt mut borrow biases, 0.05).is_ok()
    );
  done
  val List<float> predicted = arr[0.0, 0.0, 0.0, 0.0];
  Assert.true_throws(Linear.affine_batch_into(rt borrow input, weights[0], biases[0], rt mut borrow predicted).is_ok());
  val Result<float, String> loss = Linear.mse_loss(rt borrow predicted, rt borrow target);
  Assert.true_throws(loss.is_ok());
  Assert.true_throws(loss.unwrap() < 0.000001);
  Assert.true_throws(weights[0] > 1.99 && weights[0] < 2.01);
  Assert.true_throws(biases[0] > 0.99 && biases[0] < 1.01);

  val List<float> stationary_input = arr[2.0];
  val List<float> stationary_target = arr[2.0];
  val List<float> stationary_weight = arr[1.0];
  val List<float> stationary_bias = arr[0.0];
  val Result<float, String> stationary_loss = Linear.train_affine_step(
    rt borrow stationary_input, rt borrow stationary_target,
    rt mut borrow stationary_weight, rt mut borrow stationary_bias, 1.0e308
  );
  Assert.true_throws(stationary_loss.is_ok());
  Assert.equal_throws(stationary_loss.unwrap(), 0.0);
  Assert.equal_throws(stationary_weight[0], 1.0);
  Assert.equal_throws(stationary_bias[0], 0.0);

  val List<float> params = arr[5.0];
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow params, rt borrow unit_gradient, 0.5).is_ok());
  Assert.equal_throws(params[0], 4.0);

  Assert.true_throws(Linear.sgd_step_into(rt mut borrow params, rt borrow params, 0.5).is_err());
  Assert.equal_throws(params[0], 4.0);

  // A no-op empty update must not count as a successful optimizer step.
  val List<float> empty_parameters = arr[];
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow empty_parameters, rt borrow empty_gradients, 0.5).is_err());

  // Multi-parameter update followed by late rejection must preserve every slot.
  val List<float> vector_params = arr[3.0, 5.0];
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow vector_params, rt borrow vector_gradient, 0.5).is_ok());
  Assert.equal_throws(vector_params[0], 2.0);
  Assert.equal_throws(vector_params[1], 3.0);
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow vector_params, rt borrow short_target, 0.5).is_err());
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow vector_params, rt borrow ones_gradient, 0.0).is_err());
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow vector_params, rt borrow ones_gradient, -0.5).is_err());
  val List<float> overflow_gradient = arr[1.0, 1.0e308];
  Assert.true_throws(Linear.sgd_step_into(
    rt mut borrow vector_params, rt borrow overflow_gradient, 2.0
  ).is_err());
  Assert.equal_throws(vector_params[0], 2.0);
  Assert.equal_throws(vector_params[1], 3.0);

  val List<float> untouched = arr[10.0];
  Assert.true_throws(Linear.sgd_step_into(rt mut borrow untouched, rt borrow empty_gradients, 0.5).is_err());
  Assert.equal_throws(untouched[0], 10.0);
  // Affine output shape rejection and empty MSE cannot claim valid results.
  val List<float> output_untouched = arr[77.0];
  Assert.true_throws(Linear.affine_batch_into(rt borrow input, weights[0], biases[0], rt mut borrow output_untouched).is_err());
  Assert.equal_throws(output_untouched[0], 77.0);
  Assert.true_throws(Linear.mse_loss(rt borrow empty_gradients, rt borrow empty_gradients).is_err());
  // A forward overflow at the last input leaves the whole output available for retry.
  val List<float> wide_input = arr[1.0, 1.0e308];
  val List<float> forward_output = arr[17.0, 19.0];
  Assert.true_throws(Linear.affine_batch_into(
    rt borrow wide_input, 2.0, 0.0, rt mut borrow forward_output
  ).is_err());
  Assert.equal_throws(forward_output[0], 17.0);
  Assert.equal_throws(forward_output[1], 19.0);
  Assert.true_throws(Linear.affine_batch_into(
    rt borrow wide_input, 1.0, 0.0, rt mut borrow forward_output
  ).is_ok());
  Assert.equal_throws(forward_output[0], 1.0);
  Assert.equal_throws(forward_output[1], 1.0e308);
  stdio.println("ORES_ML_TRAINING_SMOKE_PASS");
  return;
}

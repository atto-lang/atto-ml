import module Assert from "std/assert";
import fnc affine_batch_into, mse_loss, train_affine_step, sgd_step_into from "../src/linear";

pub routine main(): void {
  val List<float> input = arr[0.0, 1.0, 2.0, 3.0];
  val List<float> target = arr[1.0, 3.0, 5.0, 7.0];
  val List<float> weights = arr[0.0];
  val List<float> biases = arr[0.0];

  // A forward output cannot borrow the same storage as its input. Reject
  // before any write, and retain the complete caller-owned input vector.
  val List<float> shared_forward = arr[1.0, 2.0];
  Assert.true_throws(affine_batch_into(shared_forward, 2.0, 1.0, shared_forward).is_err());
  Assert.equal_throws(shared_forward[0], 1.0);
  Assert.equal_throws(shared_forward[1], 2.0);

  // Validate before mutation, including malformed target length.
  Assert.true_throws(
    train_affine_step(input, arr[1.0], weights, biases, 0.05).is_err()
  );
  Assert.equal_throws(weights[0], 0.0);
  Assert.equal_throws(biases[0], 0.0);
  Assert.true_throws(train_affine_step(input, target, weights, weights, 0.05).is_err());
  Assert.equal_throws(weights[0], 0.0);
  // A rejected learning rate must not publish either trained scalar.
  Assert.true_throws(train_affine_step(input, target, weights, biases, 0.0).is_err());
  Assert.true_throws(train_affine_step(input, target, weights, biases, -0.05).is_err());
  Assert.equal_throws(weights[0], 0.0);
  Assert.equal_throws(biases[0], 0.0);

  for int step = 0; step < 500; step++ do
    Assert.true_throws(
      train_affine_step(input, target, weights, biases, 0.05).is_ok()
    );
  done
  val List<float> predicted = arr[0.0, 0.0, 0.0, 0.0];
  Assert.true_throws(affine_batch_into(input, weights[0], biases[0], predicted).is_ok());
  val Result<float, String> loss = mse_loss(predicted, target);
  Assert.true_throws(loss.is_ok());
  Assert.true_throws(loss.unwrap() < 0.000001);
  Assert.true_throws(weights[0] > 1.99 && weights[0] < 2.01);
  Assert.true_throws(biases[0] > 0.99 && biases[0] < 1.01);

  val List<float> params = arr[5.0];
  Assert.true_throws(sgd_step_into(params, arr[2.0], 0.5).is_ok());
  Assert.equal_throws(params[0], 4.0);

  // An aliasing mutable parameter/gradient loan must never publish an update.
  Assert.true_throws(sgd_step_into(params, params, 0.5).is_err());
  Assert.equal_throws(params[0], 4.0);
  // A no-op empty update must not count as a successful optimizer step.
  val List<float> empty_parameters = arr[];
  Assert.true_throws(sgd_step_into(empty_parameters, arr[], 0.5).is_err());

  // Multi-parameter update followed by late rejection must preserve every slot.
  val List<float> vector_params = arr[3.0, 5.0];
  Assert.true_throws(sgd_step_into(vector_params, arr[2.0, 4.0], 0.5).is_ok());
  Assert.equal_throws(vector_params[0], 2.0);
  Assert.equal_throws(vector_params[1], 3.0);
  Assert.true_throws(sgd_step_into(vector_params, arr[1.0], 0.5).is_err());
  Assert.true_throws(sgd_step_into(vector_params, arr[1.0, 1.0], 0.0).is_err());
  Assert.true_throws(sgd_step_into(vector_params, arr[1.0, 1.0], -0.5).is_err());
  Assert.equal_throws(vector_params[0], 2.0);
  Assert.equal_throws(vector_params[1], 3.0);

  val List<float> untouched = arr[10.0];
  Assert.true_throws(sgd_step_into(untouched, arr[], 0.5).is_err());
  Assert.equal_throws(untouched[0], 10.0);
  // Affine output shape rejection and empty MSE cannot claim valid results.
  val List<float> output_untouched = arr[77.0];
  Assert.true_throws(affine_batch_into(input, weights[0], biases[0], output_untouched).is_err());
  Assert.equal_throws(output_untouched[0], 77.0);
  Assert.true_throws(mse_loss(arr[], arr[]).is_err());
  stdio.println("ORES_ML_TRAINING_SMOKE_PASS");
  return;
}
